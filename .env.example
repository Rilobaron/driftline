# Driftline environment configuration (no secrets — copy to .env and adjust locally)
DRIFTLINE_ENV=development
DATABASE_URL=postgresql+psycopg://driftline:driftline@localhost:5432/driftline
# SQLite fallback for local development without Postgres:
# DATABASE_URL=sqlite:///./driftline.db

# Market data defaults (v0.1 single-market fallback)
DRIFTLINE_EXCHANGE=binance
DRIFTLINE_SYMBOL=BTC/USDT
DRIFTLINE_TIMEFRAME=1h
DRIFTLINE_LOOKBACK_MONTHS=12
DRIFTLINE_MAX_CANDLES=5000

# Backtest defaults
DRIFTLINE_INITIAL_CAPITAL=10000.0
DRIFTLINE_FEE_RATE=0.001
DRIFTLINE_SLIPPAGE_RATE=0.0005
DRIFTLINE_ALLOCATION=1.0

# API
DRIFTLINE_API_HOST=0.0.0.0
DRIFTLINE_API_PORT=8000
DRIFTLINE_LOG_LEVEL=INFO

# v0.2b market automation (spot only — no leverage/futures)
# Comma-separated exchange:SYMBOL:timeframe entries; prefix ! to disable.
DRIFTLINE_MARKET_STREAMS=binance:BTC/USDT:1h,binance:ETH/USDT:1h,binance:SOL/USDT:1h
# Seconds after each UTC candle close before syncing (exchange latency buffer).
DRIFTLINE_SYNC_DELAY_SECONDS=90
# Bootstrap depth for new streams (~months of hourly candles).
DRIFTLINE_BOOTSTRAP_MONTHS=12
# Scheduler ownership: 1 ONLY in the dedicated worker process, never in the API.
DRIFTLINE_SCHEDULER_ENABLED=0
DRIFTLINE_SCHEDULER_INTERVAL=60
# Data older than this (seconds) counts as STALE for health checks.
DRIFTLINE_STALE_AFTER_SECONDS=8100
# Provider resilience.
DRIFTLINE_FETCH_TIMEOUT=30.0
DRIFTLINE_FETCH_MAX_RETRIES=5
# Ops protection for POST /api/v1/market/sync|repair and /api/v1/paper mutations.
# When set, callers must send X-Driftline-Ops-Token (or Authorization: Bearer).
# Always set in shared deployments; local dev may leave it empty (localhost only).
DRIFTLINE_OPS_TOKEN=
# v0.2c paper trading (simulated funds only — never real orders)
DRIFTLINE_PAPER_INTERVAL=60
DRIFTLINE_PAPER_MAX_CANDLES=48
DRIFTLINE_PAPER_FEE_RATE=0.001
DRIFTLINE_PAPER_SLIPPAGE_RATE=0.0005
DRIFTLINE_PAPER_ALLOCATION=1.0
DRIFTLINE_PAPER_MIN_QTY=0.00001
DRIFTLINE_PAPER_MAX_DAILY_LOSS=0.05
DRIFTLINE_PAPER_MAX_DRAWDOWN=0.20
DRIFTLINE_PAPER_MIN_BALANCE=10.0
DRIFTLINE_PAPER_MAX_STALE=7200
